<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- wrap_content height inside a match_parent FrameLayout caps the ScrollView at the screen
         height: a short card stays centered, a tall one (big nearby list, landscape head unit)
         scrolls instead of clipping the call buttons off-screen. -->
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:fillViewport="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/popup_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/img_barrier_hero"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/textBarrierName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="Open barrier «Garage»?" />

        <!-- gate-api only: what the gate reports while the question is on screen. -->
        <TextView
            android:id="@+id/textGateState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="22sp"
            android:visibility="gone"
            tools:text="Gate: closed" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_green_background"
                android:paddingHorizontal="32dp"
                android:paddingVertical="16dp"
                android:text="@string/btn_yes"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:background="@drawable/button_red_background"
                android:paddingHorizontal="32dp"
                android:paddingVertical="16dp"
                android:text="@string/btn_no"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1.4"
                android:background="@drawable/button_blue_background"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:text="@string/btn_wait"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textAutoDismiss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="20sp"
            tools:text="Auto-dismiss in 10 s" />

        <View
            android:id="@+id/nearbyDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/outline"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nearbyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/popup_nearby_header"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/nearbyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

    </ScrollView>

</FrameLayout>
