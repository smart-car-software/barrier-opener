<!-- The question on the driver's screen, styled after the cluster's navigation-hint panel and
     sized in px on purpose: it is laid out against that one panel on that one display, not
     against a density bucket. Width and position live in ClusterPrompt. No touch on a cluster,
     so the answers are labels the wheel selects; see ClusterPrompt.paint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/cluster_card_background"
    android:orientation="vertical"
    android:paddingHorizontal="18px"
    android:paddingTop="12px"
    android:paddingBottom="14px">

    <TextView
        android:id="@+id/clusterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/cluster_text"
        android:textSize="26px" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10px"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clusterYes"
            style="@style/ClusterAnswer"
            android:text="@string/btn_yes" />

        <TextView
            android:id="@+id/clusterNo"
            style="@style/ClusterAnswer"
            android:text="@string/btn_no" />

        <TextView
            android:id="@+id/clusterWait"
            style="@style/ClusterAnswer"
            android:text="@string/btn_wait" />
    </LinearLayout>

    <!-- Diagnostic build only: see ClusterPrompt.setStatus. -->
    <TextView
        android:id="@+id/clusterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6px"
        android:gravity="center"
        android:textColor="@color/cluster_text_dim"
        android:textSize="16px"
        android:visibility="gone" />
</LinearLayout>
