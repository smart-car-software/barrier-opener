<!-- The test question the diagnostics screen puts on the driver's screen. A cluster has no
     touch, so the answers are plain labels the wheel selects; see WheelKeys.showSelection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/popup_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/clusterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clusterYes"
            style="@style/ClusterAnswer"
            android:background="@drawable/button_green_background"
            android:text="@string/btn_yes" />

        <TextView
            android:id="@+id/clusterNo"
            style="@style/ClusterAnswer"
            android:background="@drawable/button_red_background"
            android:text="@string/btn_no" />

        <TextView
            android:id="@+id/clusterWait"
            style="@style/ClusterAnswer"
            android:background="@drawable/button_blue_background"
            android:text="@string/btn_wait" />
    </LinearLayout>
</LinearLayout>
