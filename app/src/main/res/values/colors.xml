<resources>
    <!-- Brand -->
    <color name="brand_yellow">#FFD400</color>
    <color name="brand_yellow_dark">#C9A800</color>
    <color name="brand_charcoal">#1F2128</color>
    <color name="brand_charcoal_dark">#15171C</color>

    <!-- Action colors -->
    <color name="action_green">#1E8E3E</color>
    <color name="action_red">#D93025</color>
    <color name="action_blue">#1A73E8</color>
    <color name="action_gray">#5F6368</color>

    <!-- Surfaces (light) -->
    <color name="background">#FFFAFAFA</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFEFF1F4</color>
    <color name="text_primary">#FF1F2128</color>
    <color name="text_secondary">#FF5F6368</color>
    <color name="outline">#FFD3D7DC</color>

    <color name="scrim_80">#CC000000</color>

    <!-- Map controls. The zoom / search / my-location FABs float over map tiles rather than over a
         screen surface, so they get their own pair: a charcoal icon on the dark night surface was
         black-on-black and effectively invisible. -->
    <color name="map_control_background">@color/surface</color>
    <color name="map_control_icon">@color/brand_charcoal</color>

    <!-- Status indicators -->
    <color name="status_ok">#1E8E3E</color>
    <color name="status_warning">#F29900</color>
    <color name="status_error">#D93025</color>

    <!-- Legacy -->
    <color name="button_primary">@color/brand_yellow</color>
    <color name="button_secondary">@color/action_blue</color>
    <color name="badge_text">#FF1F2128</color>

    <!-- Launcher icon background -->
    <color name="ic_launcher_background">#1F2128</color>
</resources>
