<resources>
    <!-- The look shared with route-suggest and Car Notification Service, after the cluster
         (MSpeed's dark dial look): a night-blue ground, panels with a cold rim, one cyan accent
         that glows. A single dark look, day and night: there is no values-night variant. -->
    <color name="background">#FF0A1020</color>
    <color name="bg_top">#FF111B33</color>
    <color name="bg_bottom">#FF070B16</color>
    <color name="surface">#FF121C30</color>
    <color name="surface_variant">#FF18243C</color>
    <color name="outline">#FF22324F</color>
    <color name="text_primary">#FFEAF2FF</color>
    <color name="text_secondary">#FF8494B2</color>
    <color name="accent">#FF35C8FF</color>
    <color name="accent_glow">#8035C8FF</color>
    <color name="accent_dim">#2635C8FF</color>
    <color name="on_accent">#FF04111F</color>
    <color name="ok">#FF3DDC97</color>
    <color name="warn">#FFFFB547</color>
    <color name="danger">#FFFF6B7A</color>

    <color name="scrim_80">#CC000000</color>

    <!-- Map controls float over map tiles rather than over a screen surface. The map is always in
         MapKit's night style, so they are a light icon on a panel. -->
    <color name="map_control_background">@color/surface_variant</color>
    <color name="map_control_icon">@color/text_primary</color>

    <!-- Status indicators -->
    <color name="status_ok">@color/ok</color>
    <color name="status_warning">@color/warn</color>
    <color name="status_error">@color/danger</color>

    <!-- The gates' list on the cluster: the colours of the cluster's own panel there, as
         route-suggest's menu and Car Notification Service's cards. -->
    <color name="cluster_panel">#D9283442</color>
    <color name="cluster_panel_rim">#FF55657A</color>
    <color name="cluster_text">#FFF2F5F8</color>
    <color name="cluster_text_dim">#FF7D8896</color>
    <color name="cluster_accent">#FF4FB7F0</color>
    <color name="cluster_accent_fill">#594FB7F0</color>
</resources>
